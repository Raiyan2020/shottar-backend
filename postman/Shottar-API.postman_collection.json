		{
			"name": "MyFatoorah (Direct)",
			"description": "Calls MyFatoorah's own API directly (not your backend) — useful for manually checking/reconciling an order stuck in `pending` when the payment redirect never reached callback/success.",
			"item": [
				{
					"name": "Get Payment Status (by CustomerReference / order_id)",
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{myfatoorah_token}}", "type": "string" } ] },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"Key\": \"{{order_id}}\",\n  \"KeyType\": \"CustomerReference\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{myfatoorah_base_url}}/GetPaymentStatus", "host": [ "{{myfatoorah_base_url}}" ], "path": [ "GetPaymentStatus" ] },
						"description": "KeyType `CustomerReference` uses your order id directly. Response `Data.InvoiceStatus` is `Paid`/`Pending`/`Failed`/`Expired`."
					}
				},
				{
					"name": "Get Payment Status (by PaymentId)",
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{myfatoorah_token}}", "type": "string" } ] },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"Key\": \"\",\n  \"KeyType\": \"PaymentId\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{myfatoorah_base_url}}/GetPaymentStatus", "host": [ "{{myfatoorah_base_url}}" ], "path": [ "GetPaymentStatus" ] },
						"description": "KeyType `PaymentId` uses the `paymentId` query param MyFatoorah appends to the callback redirect."
					}
				},
				{
					"name": "Execute Payment (create invoice)",
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{myfatoorah_token}}", "type": "string" } ] },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"InvoiceValue\": 10.000,\n  \"PaymentMethodId\": 1,\n  \"CustomerName\": \"Test User\",\n  \"CustomerEmail\": \"info@shottar.com\",\n  \"CallBackUrl\": \"{{base_url}}/callback/success?order_id={{order_id}}\",\n  \"ErrorUrl\": \"{{base_url}}/callback/error?order_id={{order_id}}\",\n  \"CustomerReference\": \"{{order_id}}\",\n  \"Language\": \"ar\",\n  \"DisplayCurrencyIso\": \"KWD\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{myfatoorah_base_url}}/ExecutePayment", "host": [ "{{myfatoorah_base_url}}" ], "path": [ "ExecutePayment" ] },
						"description": "Mirrors what MyFatoorahService::executePayment sends — mainly useful for debugging invoice creation in isolation from your /order endpoint."
					}
				}
			]
		},
